{
  "manifest_version": 3,
  "name": "Ad Blocker",
  "version": "1.0",
  "description": "A simple ad blocker.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cheese16.png",
      "32": "icons/cheese32.png",
      "128": "icons/cheese128.png"
    }
  },
  "icons": {
    "16": "icons/cheese16.png",
    "32": "icons/cheese32.png",
    "128": "icons/cheese128.png"
  }
}
